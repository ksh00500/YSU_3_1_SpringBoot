{{>layout/header}}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">코드 리뷰 목록</h2>
    <a href="/posts/new" class="btn btn-dark">글 등록</a>
</div>

<table class="table table-hover">
    <thead>
    <tr>
        <th>제목</th>
        <th>언어</th>
        <th>작성자</th>
        <th>작성일</th>
    </tr>
    </thead>
    <tbody>
    {{#posts}}
        <tr>
            <td><a href="/posts/detail">{{title}}</a></td>
            <td>{{language}}</td>
            <td>{{author}}</td>
            <td>{{createdAt}}</td>
        </tr>
    {{/posts}}
    </tbody>
</table>

{{>layout/footer}}