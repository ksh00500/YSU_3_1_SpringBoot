{{>layout/header}}

<h2 class="mb-4">새 코드 글 작성</h2>

<form action="/posts" method="post">

    <div class="mb-3">
        <label class="form-label">제목</label>
        <input type="text" name="title" class="form-control" placeholder="제목을 입력하세요">
    </div>

    <div class="mb-3">
        <label class="form-label">언어</label>
        <select name="language" class="form-select">
            <option value="">선택하세요</option>
            <option value="Java">Java</option>
            <option value="Python">Python</option>
            <option value="JS">JavaScript</option>
            <option value="C">C</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label">코드 본문</label>
        <textarea name="code" class="form-control" rows="8" placeholder="여기에 코드를 붙여넣으세요"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">설명</label>
        <textarea name="description" class="form-control" rows="3" placeholder="어떤 점을 봐줬으면 하는지 적어주세요"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">작성자</label>
        <input type="text" name="author" class="form-control" placeholder="이름">
    </div>

    <button type="submit" class="btn btn-dark">저장</button>
    <a href="/posts" class="btn btn-outline-secondary">취소</a>

</form>

{{>layout/footer}}